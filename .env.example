# Database Connection
# Local SQLite fallback (development only):
# DATABASE_URL="file:./dev.db"
# Cloud PostgreSQL (Recommended for production on Supabase or Neon - zero data stored on your PC):
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
# Optional direct migration URL (used if DATABASE_URL uses PgBouncer connection pooling):
DIRECT_URL=""

# Signed session & verification token secret (set a 32+ character random value in production)
AUTH_SECRET=""

# Supabase Storage (Free 1 GB private + public object storage for Student IDs & Product Photos)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PRODUCTS_BUCKET="product-photos"
SUPABASE_KYC_BUCKET="kyc-documents"

# Resend Email API (for sending verification & password-reset codes)
RESEND_API_KEY=""
RESEND_FROM="UniShare <no-reply@unishare.online>"

# UltraMsg WhatsApp Cloud Gateway (Automated SOS dispatch)
ULTRAMSG_INSTANCE_ID=""
ULTRAMSG_TOKEN=""

# Google Maps Platform (JavaScript API, Places API (New), Routes API)
# Restrict in Google Cloud Console via HTTP referrers: https://unishare.online/*, http://localhost:3000/*
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
