DATABASE_URL="file:./dev.db"

# Signed session & verification token secret (set a long random value in production)
AUTH_SECRET=""

# Dual Email Routing:
# - Actual student & personal emails (.edu, .ac.bd, Gmail, etc.) -> Resend first
# - Temp-Mail / disposable domains -> Secondary provider first (Gmail SMTP, SMTP2GO/SendPulse/Mailjet SMTP, or Brevo)
RESEND_API_KEY=""
RESEND_FROM="UniShare <no-reply@unishare.online>"

# Option 1 (Free, zero domain verification, easiest Temp-Mail partner alongside Resend): Gmail App Password
# GMAIL_USER="yourname@gmail.com"
# GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Option 2 (Free SMTP without Brevo: SMTP2GO 200/day, SendPulse 400/day, Mailjet 200/day)
# SMTP_HOST="mail.smtp2go.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="UniShare <no-reply@unishare.online>"

# Option 3 (Optional Brevo API)
# BREVO_API_KEY=""
# BREVO_FROM="UniShare <your-verified-sender@gmail.com>"

# Optional fallback From header or extra comma-separated temp-mail domains
# MAIL_FROM="UniShare <no-reply@unishare.online>"
# TEMP_MAIL_DOMAINS=""
