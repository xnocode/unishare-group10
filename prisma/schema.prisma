generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Student Account
model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  fullName           String
  studentId          String?
  university         String?
  universityId       String?
  isCustomUniversity Boolean            @default(false)
  department         String?
  programme          String?
  academicSession    String?
  passwordHash       String
  emailVerified      Boolean            @default(false)
  verified           Boolean            @default(false)
  tokenBalance       Int                @default(50)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt
  emergencyContacts  EmergencyContact[]
  emergencySessions  EmergencySession[]

  // Self-declared profile gender (Private, used strictly for safety preference matching)
  gender             String?

  // Private Student ID Verification Storage Keys (stored strictly in private bucket, never public URLs)
  idCardPhotoPath    String?
  facePhotoPath      String?

  // User Notification & Safety Preferences JSON
  preferencesJson    String?

  // Destination-based Live Companion Matching
  travelJourneys     TravelJourney[]      @relation("UserTravelJourneys")
  ridePresence       RidePresence?        @relation("UserRidePresence")

  // Campus Marketplace & Financial Records
  marketplaceListings MarketplaceListing[]  @relation("UserMarketplaceListings")
  favorites           MarketplaceFavorite[] @relation("UserFavorites")
  rentalsBorrowed     MarketplaceRental[]   @relation("UserBorrowedRentals")
  rentalsLent         MarketplaceRental[]   @relation("UserLentRentals")
  walletTransactions  WalletTransaction[]   @relation("UserWalletTransactions")
  notifications       Notification[]        @relation("UserNotifications")
}

model AuthVerificationCode {
  id         String    @id @default(cuid())
  email      String
  purpose    String    @default("EMAIL_VERIFY") // EMAIL_VERIFY | PASSWORD_RESET
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
}

model EmergencyContact {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  phoneNumber  String
  relationship String
  priority     Int      // 1 to 5
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  callAttempts  EmergencyCallAttempt[]
  smsDispatches EmergencySmsDispatch[]

  @@index([userId])
}

model EmergencySession {
  id                String                 @id @default(cuid())
  userId            String
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            String                 @default("ACTIVE") // ACTIVE, RESOLVED, CANCELLED
  callingStatus     String                 @default("INITIATING") // INITIATING, ESCALATING, CONTACT_REACHED, EXHAUSTED, CANCELLED
  triggerReason     String?                @default("SOS Emergency Triggered")
  resolvedReason    String?
  answeredContactId String?
  activeCallSid     String?
  trackingToken     String?                @unique
  latestLatitude    Float?
  latestLongitude   Float?
  latestAccuracy    Float?
  latestLocationAt  DateTime?
  gpsStatus         String?                @default("PENDING") // PENDING, GRANTED, DENIED, UNAVAILABLE, TIMEOUT
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  resolvedAt        DateTime?

  callAttempts      EmergencyCallAttempt[]
  locationUpdates   EmergencyLocationUpdate[]
  smsDispatches     EmergencySmsDispatch[]

  @@index([userId])
}

model EmergencyCallAttempt {
  id              String            @id @default(cuid())
  sessionId       String
  session         EmergencySession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  contactId       String?
  contact         EmergencyContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactName     String
  phoneNumber     String
  priority        Int
  attemptNumber   Int               @default(1) // 1 or 2
  status          String            // INITIATED, RINGING, ANSWERED, UNANSWERED, BUSY, FAILED, CANCELLED
  provider        String            // "TWILIO" or "MOCK_SIMULATOR"
  telephonySid    String?
  durationSeconds Int               @default(0)
  errorMessage    String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([sessionId])
}

model EmergencyLocationUpdate {
  id         String           @id @default(cuid())
  sessionId  String
  session    EmergencySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  accuracy   Float?
  heading    Float?
  speed      Float?
  timestamp  DateTime         @default(now())

  @@index([sessionId])
}

model EmergencySmsDispatch {
  id            String            @id @default(cuid())
  sessionId     String
  session       EmergencySession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       EmergencyContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  recipientName String
  phoneNumber   String
  messageBody   String
  status        String            // QUEUED, SENT, DELIVERED, FAILED, MOCK_SENT
  provider      String            // "TWILIO" or "MOCK_SIMULATOR"
  telephonySid  String?
  errorMessage  String?
  sentAt        DateTime?
  createdAt     DateTime          @default(now())

  @@index([sessionId])
}

// -------------------------------------------------------------
// Campus Ride Sharing · Destination-Based Live Student Matching
// Strictly Peer-to-Peer Student Travel Partners (Zero Seats / Zero Drivers)
// -------------------------------------------------------------

model TravelJourney {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation("UserTravelJourneys", fields: [userId], references: [id], onDelete: Cascade)
  origin           String   // Pickup point e.g. "Dhanmondi 27, Dhaka"
  originLat        Float?
  originLng        Float?
  destination      String   // Dropoff / Destination e.g. "TSC, University of Dhaka"
  destinationLat   Float?
  destinationLng   Float?
  departureTime    DateTime @default(now())
  genderPreference String   @default("no_preference") // "no_preference" | "women_only" | "men_only"
  status           String   @default("ACTIVE")         // "ACTIVE" | "COMPLETED" | "CANCELLED"
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([destination])
  @@index([genderPreference])
  @@index([status])
  @@index([departureTime])
}

model RidePresence {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation("UserRidePresence", fields: [userId], references: [id], onDelete: Cascade)
  lat                 Float
  lng                 Float
  pickupLocation      String
  destinationLocation String?
  destinationLat      Float?
  destinationLng      Float?
  genderPreference    String   @default("no_preference")
  updatedAt           DateTime @updatedAt
  expiresAt           DateTime

  @@index([expiresAt])
}

// Multi-Partner Travel Request / Invitation (Zero Driver / Zero Seats)
model TravelPartnerInvitation {
  id           String              @id @default(cuid())
  senderId     String
  receiverId   String
  journeyId    String?
  status       String              @default("PENDING") // PENDING, ACCEPTED, REJECTED, CANCELLED
  message      String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  conversation TravelConversation?

  @@index([senderId])
  @@index([receiverId])
  @@index([journeyId])
  @@index([status])
}

// Private Peer-to-Peer Travel Coordination Conversation
model TravelConversation {
  id               String                   @id @default(cuid())
  invitationId     String?                  @unique
  invitation       TravelPartnerInvitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  participant1Id   String
  participant2Id   String
  meetingLocation  String?
  meetingLat       Float?
  meetingLng       Float?
  meetingConfirmed Boolean                  @default(false)
  status           String                   @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  messages         TravelMessage[]
  tracking         TravelLiveTracking?
  reviews          TravelReview[]

  @@index([participant1Id])
  @@index([participant2Id])
  @@index([status])
}

// Consent-Based Live Journey GPS Tracking Session
model TravelLiveTracking {
  id                  String             @id @default(cuid())
  conversationId      String             @unique
  conversation        TravelConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Explicit Participant Consents (both must consent before tracking begins)
  participant1Consent Boolean            @default(false)
  participant2Consent Boolean            @default(false)

  // Active Sharing States (participants can pause/stop sharing independently)
  participant1Sharing Boolean            @default(false)
  participant2Sharing Boolean            @default(false)

  // Participant 1 Live Telemetry
  p1Lat               Float?
  p1Lng               Float?
  p1Accuracy          Float?
  p1Heading           Float?
  p1Speed             Float?
  p1UpdatedAt         DateTime?

  // Participant 2 Live Telemetry
  p2Lat               Float?
  p2Lng               Float?
  p2Accuracy          Float?
  p2Heading           Float?
  p2Speed             Float?
  p2UpdatedAt         DateTime?

  // Journey Lifecycle
  journeyStatus              String             @default("NOT_STARTED") // "NOT_STARTED", "IN_PROGRESS", "COMPLETED", "CANCELLED"
  startedAt                  DateTime?
  completedAt                DateTime?

  // Destination & Arrival Detection
  destinationLat             Float?
  destinationLng             Float?
  destinationName            String?
  proximityThresholdMeters   Float              @default(100) // Configurable arrival threshold (default 100m)
  p1Arrived                  Boolean            @default(false)
  p1ArrivedAt                DateTime?
  p1ConsecutiveArrivalPings  Int                @default(0)
  p2Arrived                  Boolean            @default(false)
  p2ArrivedAt                DateTime?
  p2ConsecutiveArrivalPings  Int                @default(0)

  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  @@index([conversationId])
  @@index([journeyStatus])
}

// Travel Partner Private Messages & Meeting Spot Updates
model TravelMessage {
  id             String             @id @default(cuid())
  conversationId String
  conversation   TravelConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  senderName     String
  text           String
  messageType    String             @default("TEXT") // "TEXT" | "MEETING_LOCATION" | "STATUS_UPDATE"
  locationName   String?
  locationLat    Float?
  locationLng    Float?
  createdAt      DateTime           @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

// Travel Companion Review & Safety Report for Completed Journeys
model TravelReview {
  id              String             @id @default(cuid())
  conversationId  String
  conversation    TravelConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reviewerId      String
  partnerId       String

  // Rating & Feedback
  rating          Int                // 1 to 5 stars
  feedback        String?            // Optional written review / feedback

  // Safety & Behavioral Reporting
  reported        Boolean            @default(false)
  reportCategory  String?            // e.g. "HARASSMENT", "SAFETY_CONCERN", "INAPPROPRIATE_BEHAVIOR", "NO_SHOW", "OTHER"
  reportDetails   String?            // Confidential details for campus safety team

  createdAt       DateTime           @default(now())

  @@unique([conversationId, reviewerId])
  @@index([conversationId])
  @@index([reviewerId])
  @@index([partnerId])
  @@index([reported])
}

// -------------------------------------------------------------
// Campus Marketplace Listings (Cloud DB & Object Storage Backed)
// -------------------------------------------------------------

model MarketplaceListing {
  id             String   @id @default(cuid())
  sellerId       String
  seller         User     @relation("UserMarketplaceListings", fields: [sellerId], references: [id], onDelete: Cascade)
  sellerEmail    String
  sellerName     String
  sellerInitials String
  university     String?
  title          String
  category       String
  condition      String   @default("Good")
  rate           Int
  deposit        Int
  area           String   @default("TSC")
  maxRentalDays  Int      @default(7)
  description    String
  imageUrl       String
  status         String   @default("active") // "active" | "paused" | "draft"
  isRentedOut    Boolean  @default(false)
  available      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rentals        MarketplaceRental[]
  favorites      MarketplaceFavorite[]

  @@index([sellerId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

model MarketplaceFavorite {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

model MarketplaceRental {
  id            String             @id @default(cuid())
  listingId     String
  listing       MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingTitle  String
  listingImage  String
  borrowerId    String
  borrower      User               @relation("UserBorrowedRentals", fields: [borrowerId], references: [id], onDelete: Cascade)
  borrowerName  String
  borrowerEmail String
  lenderId      String
  lender        User               @relation("UserLentRentals", fields: [lenderId], references: [id], onDelete: Cascade)
  lenderName    String
  lenderEmail   String
  startDate     String
  endDate       String
  days          Int
  ratePerDay    Int
  rentalFee     Int
  depositAmount Int
  totalLocked   Int
  note          String?
  status        String             @default("PENDING") // PENDING | ACTIVE | RETURNED | DECLINED | CANCELLED
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  returnedAt    DateTime?

  @@index([listingId])
  @@index([borrowerId])
  @@index([lenderId])
  @@index([status])
}

model WalletTransaction {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("UserWalletTransactions", fields: [userId], references: [id], onDelete: Cascade)
  type         String   // TOPUP | TRANSFER_IN | TRANSFER_OUT | RENTAL_HOLD | RENTAL_REFUND | RENTAL_EARN | BONUS
  title        String
  subtitle     String?
  amount       Int      // Signed token delta (+ credit, - debit)
  balanceAfter Int
  referenceId  String?
  status       String   @default("COMPLETED") // COMPLETED | PENDING
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  category    String   @default("marketplace") // marketplace | rides | wallet | verification | safety
  title       String
  body        String
  actionLabel String?
  actionHref  String?
  unread      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([unread])
  @@index([createdAt])
}
