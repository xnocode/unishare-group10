generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Student Account
model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  fullName           String
  studentId          String?
  university         String?
  universityId       String?
  isCustomUniversity Boolean            @default(false)
  department         String?
  programme          String?
  academicSession    String?
  passwordHash       String
  emailVerified      Boolean            @default(false)
  verified           Boolean            @default(false)
  tokenBalance       Int                @default(50)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt
  emergencyContacts  EmergencyContact[]
  emergencySessions  EmergencySession[]

  // Ride Sharing Relations
  hostedRides        Ride[]            @relation("HostedRides")
  rideRequests       RideRequest[]     @relation("PassengerRequests")
  rideParticipations RideParticipant[] @relation("RideParticipations")
}

model AuthVerificationCode {
  id         String    @id @default(cuid())
  email      String
  purpose    String    @default("EMAIL_VERIFY") // EMAIL_VERIFY | PASSWORD_RESET
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
}

model EmergencyContact {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  phoneNumber  String
  relationship String
  priority     Int      // 1 to 5
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  callAttempts  EmergencyCallAttempt[]
  smsDispatches EmergencySmsDispatch[]

  @@index([userId])
}

model EmergencySession {
  id                String                 @id @default(cuid())
  userId            String
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            String                 @default("ACTIVE") // ACTIVE, RESOLVED, CANCELLED
  callingStatus     String                 @default("INITIATING") // INITIATING, ESCALATING, CONTACT_REACHED, EXHAUSTED, CANCELLED
  triggerReason     String?                @default("SOS Emergency Triggered")
  resolvedReason    String?
  answeredContactId String?
  activeCallSid     String?
  trackingToken     String?                @unique
  latestLatitude    Float?
  latestLongitude   Float?
  latestAccuracy    Float?
  latestLocationAt  DateTime?
  gpsStatus         String?                @default("PENDING") // PENDING, GRANTED, DENIED, UNAVAILABLE, TIMEOUT
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  resolvedAt        DateTime?

  callAttempts      EmergencyCallAttempt[]
  locationUpdates   EmergencyLocationUpdate[]
  smsDispatches     EmergencySmsDispatch[]

  @@index([userId])
}

model EmergencyCallAttempt {
  id              String            @id @default(cuid())
  sessionId       String
  session         EmergencySession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  contactId       String?
  contact         EmergencyContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactName     String
  phoneNumber     String
  priority        Int
  attemptNumber   Int               @default(1) // 1 or 2
  status          String            // INITIATED, RINGING, ANSWERED, UNANSWERED, BUSY, FAILED, CANCELLED
  provider        String            // "TWILIO" or "MOCK_SIMULATOR"
  telephonySid    String?
  durationSeconds Int               @default(0)
  errorMessage    String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([sessionId])
}

model EmergencyLocationUpdate {
  id         String           @id @default(cuid())
  sessionId  String
  session    EmergencySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  accuracy   Float?
  heading    Float?
  speed      Float?
  timestamp  DateTime         @default(now())

  @@index([sessionId])
}

model EmergencySmsDispatch {
  id            String            @id @default(cuid())
  sessionId     String
  session       EmergencySession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       EmergencyContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  recipientName String
  phoneNumber   String
  messageBody   String
  status        String            // QUEUED, SENT, DELIVERED, FAILED, MOCK_SENT
  provider      String            // "TWILIO" or "MOCK_SIMULATOR"
  telephonySid  String?
  errorMessage  String?
  sentAt        DateTime?
  createdAt     DateTime          @default(now())

  @@index([sessionId])
}

// -------------------------------------------------------------
// Campus Ride Sharing Models
// -------------------------------------------------------------

// 1. Ride Listing / Offer (Pickup, Destination, Vehicle, Gender Preferences)
model Ride {
  id               String            @id @default(cuid())
  hostId           String
  host             User              @relation("HostedRides", fields: [hostId], references: [id], onDelete: Cascade)
  vehicle          String            // "Car" | "Rickshaw" | "Bike"
  vehicleModel     String            // e.g. "Toyota Corolla (White) · Dhaka Metro Ga 21-4820"
  origin           String            // Pickup point e.g. "Dhanmondi 27, Dhaka"
  destination      String            // Dropoff point e.g. "TSC, University of Dhaka"
  departureTime    DateTime
  totalSeats       Int               @default(3)
  seatsLeft        Int               @default(3)
  genderPreference String            @default("any") // "any" | "women_only" | "men_only" | "no_preference"
  fareTokens       Int               @default(0)     // Cost in tokens per seat
  status           String            @default("SCHEDULED") // SCHEDULED, ACTIVE, COMPLETED, CANCELLED
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  requests         RideRequest[]
  participants     RideParticipant[]

  @@index([hostId])
  @@index([origin, destination])
  @@index([departureTime])
  @@index([status])
}

// 2. Ride Join Request (Booking / Passenger Requests)
model RideRequest {
  id               String            @id @default(cuid())
  rideId           String
  ride             Ride              @relation(fields: [rideId], references: [id], onDelete: Cascade)
  passengerId      String
  passenger        User              @relation("PassengerRequests", fields: [passengerId], references: [id], onDelete: Cascade)
  seatsRequested   Int               @default(1)
  pickupLocation   String?           // Specific pickup location requested by passenger
  dropoffLocation  String?           // Specific dropoff location requested by passenger
  gender           String?           // Stored gender for safety preference matching
  status           String            @default("PENDING") // PENDING, ACCEPTED, REJECTED, CANCELLED
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([rideId])
  @@index([passengerId])
  @@index([status])
}

// 3. Ride Participants (Confirmed Passengers & Host in a Ride)
model RideParticipant {
  id              String            @id @default(cuid())
  rideId          String
  ride            Ride              @relation(fields: [rideId], references: [id], onDelete: Cascade)
  userId          String
  user            User              @relation("RideParticipations", fields: [userId], references: [id], onDelete: Cascade)
  role            String            @default("PASSENGER") // "HOST" | "PASSENGER"
  seatsOccupied   Int               @default(1)
  pickupLocation  String?
  dropoffLocation String?
  farePaid        Int               @default(0)
  joinedAt        DateTime          @default(now())

  @@unique([rideId, userId])
  @@index([rideId])
  @@index([userId])
}
